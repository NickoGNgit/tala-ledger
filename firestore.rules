rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() <= 128
        && data.photoURL is string && data.photoURL.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedgerState(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'schemaVersion',
          'clientUpdatedAt',
          'deviceId',
          'preferences',
          'scheduleMeta',
          'activePayoutId',
          'payouts',
          'recurringTemplates',
          'activeSavingsAccountId',
          'savingsAccounts',
          'activePayableId',
          'payables',
          'activeReceivableId',
          'receivables',
          'activeRemittanceId',
          'remittances',
          'creditCards',
          'bills',
          'billNotifications',
          'savedNames',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'schemaVersion',
          'clientUpdatedAt',
          'deviceId',
          'preferences',
          'scheduleMeta',
          'activePayoutId',
          'payouts',
          'recurringTemplates',
          'activeSavingsAccountId',
          'savingsAccounts',
          'activePayableId',
          'payables',
          'activeReceivableId',
          'receivables',
          'activeRemittanceId',
          'remittances',
          'creditCards',
          'bills',
          'billNotifications',
          'savedNames',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid)
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100
        && data.clientUpdatedAt is number && data.clientUpdatedAt >= 0
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64
        && data.preferences is map && data.preferences.size() <= 20
        && data.scheduleMeta is map && data.scheduleMeta.size() <= 10
        && (data.activePayoutId == null || (data.activePayoutId is string && data.activePayoutId.size() <= 128))
        && data.payouts is list && data.payouts.size() <= 500 && (data.payouts.size() == 0 || data.payouts[0] is map)
        && data.recurringTemplates is list && data.recurringTemplates.size() <= 200 && (data.recurringTemplates.size() == 0 || data.recurringTemplates[0] is map)
        && (data.activeSavingsAccountId == null || (data.activeSavingsAccountId is string && data.activeSavingsAccountId.size() <= 128))
        && data.savingsAccounts is list && data.savingsAccounts.size() <= 100 && (data.savingsAccounts.size() == 0 || data.savingsAccounts[0] is map)
        && (data.activePayableId == null || (data.activePayableId is string && data.activePayableId.size() <= 128))
        && data.payables is list && data.payables.size() <= 200 && (data.payables.size() == 0 || data.payables[0] is map)
        && (data.activeReceivableId == null || (data.activeReceivableId is string && data.activeReceivableId.size() <= 128))
        && data.receivables is list && data.receivables.size() <= 200 && (data.receivables.size() == 0 || data.receivables[0] is map)
        && (data.activeRemittanceId == null || (data.activeRemittanceId is string && data.activeRemittanceId.size() <= 128))
        && data.remittances is list && data.remittances.size() <= 100 && (data.remittances.size() == 0 || data.remittances[0] is map)
        && data.creditCards is list && data.creditCards.size() <= 100 && (data.creditCards.size() == 0 || data.creditCards[0] is map)
        && data.bills is list && data.bills.size() <= 300 && (data.bills.size() == 0 || data.bills[0] is map)
        && data.billNotifications is map && data.billNotifications.size() <= 10
        && data.savedNames is map && data.savedNames.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachment(data, userId, attachmentId) {
      return data.keys().hasAll(['ownerUid', 'attachmentId', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'attachmentId', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid)
        && data.attachmentId is string && data.attachmentId == attachmentId && isValidId(data.attachmentId)
        && data.dataUrl is string && data.dataUrl.size() >= 15 && data.dataUrl.size() <= 900000 && data.dataUrl.matches('^data:image/.*')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /ledger/{ledgerId} {
        allow get: if isValidId(userId) && isValidId(ledgerId) && ledgerId == 'main' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(ledgerId)
          && ledgerId == 'main'
          && isOwner(userId)
          && isValidLedgerState(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(ledgerId)
          && ledgerId == 'main'
          && isOwner(userId)
          && isValidLedgerState(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'schemaVersion',
            'clientUpdatedAt',
            'deviceId',
            'preferences',
            'scheduleMeta',
            'activePayoutId',
            'payouts',
            'recurringTemplates',
            'activeSavingsAccountId',
            'savingsAccounts',
            'activePayableId',
            'payables',
            'activeReceivableId',
            'receivables',
            'activeRemittanceId',
            'remittances',
            'creditCards',
            'bills',
            'billNotifications',
            'savedNames',
            'updatedAt'
          ])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(ledgerId) && ledgerId == 'main' && isOwner(userId);
      }

      match /attachments/{attachmentId} {
        allow get: if isValidId(userId) && isValidId(attachmentId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attachmentId)
          && isOwner(userId)
          && isValidAttachment(incoming(), userId, attachmentId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(attachmentId)
          && isOwner(userId)
          && isValidAttachment(incoming(), userId, attachmentId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().attachmentId == existing().attachmentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['dataUrl', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(attachmentId) && isOwner(userId);
      }
    }
  }
}
